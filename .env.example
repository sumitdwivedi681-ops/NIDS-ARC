
# NIDS ARC — Environment Configuration 

# --- Application ---
APP_NAME=NIDS ARC
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# --- Operating Mode ---
# Options: simulation, real, replay
APP_MODE=simulation

# --- Database ---
# For development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./nids_arc.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nids_arc

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_JWT_SECRET_AT_LEAST_64_CHARS
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# --- Default Admin Account (created on first run) ---
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY
DEFAULT_ADMIN_EMAIL=admin@nidsarc.local

# --- Rate Limiting ---
RATE_LIMIT_AUTH=100/minute
RATE_LIMIT_API=1000/minute

# --- Detection ---
DETECTION_SIGNATURE_ENABLED=true
DETECTION_ANOMALY_ENABLED=true
DETECTION_BEHAVIORAL_ENABLED=true
DETECTION_ML_ENABLED=true
DETECTION_THREAT_INTEL_ENABLED=true

# --- Anomaly Detection ---
ANOMALY_BASELINE_LEARNING_PERIOD_HOURS=24
ANOMALY_SENSITIVITY=medium
ANOMALY_MIN_SAMPLES=100

# --- ML ---
ML_MODEL_PATH=backend/ml/models
ML_INFERENCE_BATCH_SIZE=32
ML_INFERENCE_TIMEOUT_MS=50

# --- Simulation ---
SIMULATION_EVENTS_PER_SECOND=10
SIMULATION_ATTACK_PROBABILITY=0.05
SIMULATION_SEED=42

# --- Response ---
RESPONSE_DEFAULT_MODE=alert_only
RESPONSE_DRY_RUN=true
RESPONSE_MANUAL_APPROVAL=true

# --- Data Retention ---
RETENTION_EVENTS_DAYS=90
RETENTION_ALERTS_DAYS=365
RETENTION_AUDIT_DAYS=365
RETENTION_PCAP_DAYS=30

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# --- External Integrations (optional) ---
# SURICATA_EVE_LOG_PATH=/var/log/suricata/eve.json
# ZEEK_LOG_DIR=/var/log/zeek/current
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_TOPIC=nids-arc-events
